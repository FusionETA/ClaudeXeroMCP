# Xero app credentials — from https://developer.xero.com/app/manage
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Must match a redirect URI configured on your Xero app.
# Defaults to http://localhost:<PORT>/callback if unset.
XERO_REDIRECT_URI=http://localhost:3000/callback

# Space-separated OAuth scopes. Leave unset to use the default granular
# scope set defined in server.js (invoices, payments, contacts, settings,
# reports, offline_access).
XERO_SCOPES=

# Local server port
PORT=3000

# NeonDB (Postgres) connection string
DATABASE_URL=

# ── Optional: remote MCP (Claude.ai / Railway) ──────────────────────────────

# Shared-secret bearer token required on /sse and /mcp when serving Claude.ai
# as a remote connector. Leave unset to allow unauthenticated access (fine
# for localhost-only use).
MCP_AUTH_TOKEN=

# Public base URL for the remote MCP link shown in the web UI. Auto-detected
# from the request, or from RAILWAY_PUBLIC_DOMAIN on Railway — only set this
# if you need to override both.
PUBLIC_BASE_URL=
